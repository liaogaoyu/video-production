[Unit]
Description=Storydock API
After=network.target

[Service]
Type=simple
User=storydock
Group=storydock
WorkingDirectory=/opt/storydock
Environment=STORYDOCK_ROOT=/srv/storydock
Environment=STORYDOCK_MASTER_KEY=/etc/storydock/master-key
Environment=STORYDOCK_RUNTIME_DIR=/run/storydock
Environment=HOST=127.0.0.1
Environment=PORT=4320
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/storydock-browsers
EnvironmentFile=-/etc/storydock/storydock.env
RuntimeDirectory=storydock
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
InaccessiblePaths=-/run/docker.sock
ExecStart=/usr/bin/node server/main.cjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
