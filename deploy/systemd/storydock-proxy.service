[Unit]
Description=StoryDock dedicated Dreamina VLESS XHTTP proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=storydock
Group=storydock
ExecStart=/srv/storydock/proxy/bin/xray run -config /srv/storydock/proxy/xray.json
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/srv/storydock/proxy

[Install]
WantedBy=multi-user.target
