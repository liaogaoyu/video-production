[Unit]
Description=Storydock worker
After=network.target docker.service

[Service]
Type=simple
User=storydock
Group=storydock
SupplementaryGroups=docker
WorkingDirectory=/opt/storydock
Environment=STORYDOCK_ROOT=/srv/storydock
Environment=STORYDOCK_MASTER_KEY=/etc/storydock/master-key
Environment=STORYDOCK_RUNTIME_DIR=/run/storydock
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/storydock-browsers
EnvironmentFile=-/etc/storydock/storydock.env
RuntimeDirectory=storydock
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
ExecStart=/usr/bin/node worker/main.cjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
